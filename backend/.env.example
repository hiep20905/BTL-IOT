# Sao chép file này thành .env rồi điền thông tin thật
# copy .env.example .env

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=iot_db

# --- MQTT Broker (Mosquitto) ---
# Backend chạy cùng máy với broker nên dùng localhost.
# (192.168.137.1 trong firmware ESP32 là IP gateway của Mobile Hotspot, dành cho client ở xa.)
MQTT_HOST=localhost
MQTT_PORT=1884
MQTT_USERNAME=hiep
MQTT_PASSWORD=123
MQTT_CLIENT_ID=iot_backend
TOPIC_SENSOR=Data_Sensor
TOPIC_CONTROL=Device_Control
TOPIC_RESPONSE=Device_Response

# --- JWT ---
JWT_SECRET=doi-chuoi-nay-thanh-mot-chuoi-ngau-nhien-dai
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# --- Nghiệp vụ ---
ACTION_TIMEOUT_SECONDS=10
OFFLINE_TIMEOUT_SECONDS=20
